# ===========================================
# Mock NPCI - Environment Configuration
# ===========================================
# Copy this file to .env and set real values.
# .env is gitignored - never commit secrets.
# ===========================================

# Profile: prod,ssl (default) or dev,ssl
SPRING_PROFILES_ACTIVE=prod,ssl

# Server (HTTP: 8083, HTTPS/ssl: 8445)
SERVER_PORT=8445

# SSL / Certificates (paths relative to project root)
SSL_KEY_STORE=file:../certs/npci-keystore.jks
SSL_KEY_STORE_PASSWORD=IMPS-Backend
