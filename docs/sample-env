# ===========================================
# Sample environment variables for IMPS project
# ===========================================
# Each application has a .env file in its directory (Imps-backend/.env, mock_switch/.env, mock_npci/.env).
# application.yml reads these when the process is started with the env loaded.
#
# How to run with .env loaded
# --------------------------
# Linux / Mac (Bash):
#   cd Imps-backend
#   set -a && source .env && set +a && mvn spring-boot:run
#
#   cd mock_switch
#   set -a && source .env && set +a && mvn spring-boot:run
#
#   cd mock_npci
#   set -a && source .env && set +a && mvn spring-boot:run
#
# Windows (PowerShell) – load .env then run:
#   cd Imps-backend
#   Get-Content .env | ForEach-Object { if ($_ -match '^\s*([^#][^=]+)=(.*)$') { [Environment]::SetEnvironmentVariable($matches[1].Trim(), $matches[2].Trim(), 'Process') } }; mvn spring-boot:run
#
#   (Same pattern for mock_switch and mock_npci: cd to folder, then the Get-Content line with mvn spring-boot:run.)
#
# HTTPS (ssl profile): append -Dspring-boot.run.profiles=ssl to mvn spring-boot:run.
# Docker: use env_file: .env in docker-compose.
# ===========================================

