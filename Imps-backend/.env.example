# ===========================================
# IMPS Backend - Environment Configuration
# ===========================================
# Copy this file to .env and set real values.
# .env is gitignored - never commit secrets.
# ===========================================

# Profile: prod,ssl (default) or dev,ssl (env vars below define behavior)
SPRING_PROFILES_ACTIVE=prod,ssl

# Server (dev+ssl: 8443, prod+ssl: 8443)
SERVER_PORT=8443

# Database (required for prod; prod requires SPRING_DATASOURCE_PASSWORD)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/imps_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=root

# JPA – prod: validate/false, dev: update/true
SPRING_JPA_HIBERNATE_DDL=validate
SPRING_JPA_SHOW_SQL=false
SPRING_JPA_FORMAT_SQL=false

# Logging – prod: INFO/WARN, dev: DEBUG
LOGGING_LEVEL_ROOT=INFO
LOGGING_LEVEL_COM_HITACHI_IMPS=INFO
LOGGING_LEVEL_ORG_HIBERNATE_SQL=WARN
# Dev example: SPRING_JPA_HIBERNATE_DDL=update SPRING_JPA_SHOW_SQL=true LOGGING_LEVEL_COM_HITACHI_IMPS=DEBUG

# IMPS server (for banner/display)
IMPS_SERVER_HOST=localhost
IMPS_SERVER_PROTOCOL=https
IMPS_ORG_ID=BANK01

# SSL / Certificates (use file:path - absolute or relative to working dir)
# Example Windows: file:C:/Hitachi_Project/certs/imps-keystore.jks
SSL_KEY_STORE=file:../certs/imps-keystore.jks
SSL_KEY_STORE_PASSWORD=IMPS-Backend
SSL_TRUST_STORE=file:../certs/imps-truststore.jks
SSL_TRUST_STORE_PASSWORD=IMPS-Backend

# NPCI
NPCI_SOCKET_HOST=192.168.1.38
NPCI_SOCKET_PORT=9445
NPCI_TRUST_STORE=file:../certs/imps-truststore.jks

# Routing - NPCI
ROUTING_NPCI_BASE_URL=https://localhost:8445

# Routing - Switch
ROUTING_SWITCH_BASE_URL=https://localhost:8444
ROUTING_SWITCH_SOCKET_HOST=localhost
ROUTING_SWITCH_SOCKET_PORT=9084
ROUTING_SWITCH_SSL_PORT=9444
ROUTING_SWITCH_TRUST_STORE=file:../certs/switch-truststore.jks

# IMPS Switch fallback (institution_master null)
IMPS_SWITCH_DEFAULT_HOST=localhost
IMPS_SWITCH_DEFAULT_PORT=9084

# CORS (comma-separated origins)
# CORS_ALLOWED_ORIGINS=http://localhost:3000,https://myfrontend.com
