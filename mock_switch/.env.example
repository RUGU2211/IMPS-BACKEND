# ===========================================
# Mock Switch - Environment Configuration
# ===========================================
# Copy this file to .env and set real values.
# .env is gitignored - never commit secrets.
# ===========================================

# Profile: prod,ssl (default) or dev,ssl
SPRING_PROFILES_ACTIVE=prod,ssl

# Server (HTTP: 8082, HTTPS/ssl: 8444)
SERVER_PORT=8444

# Database
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/switch_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=root

# IMPS Backend (for outbound proxy)
IMPS_ENABLED=true
IMPS_IP=192.168.1.38
IMPS_PORT=8081
IMPS_SSL_PORT=8443

# JPA – prod: validate/false, dev: update/true (from profile)
SPRING_JPA_HIBERNATE_DDL=validate
SPRING_JPA_SHOW_SQL=false

# SSL / Certificates (paths relative to project root)
SSL_KEY_STORE=file:../certs/switch-keystore.jks
SSL_KEY_STORE_PASSWORD=IMPS-Backend
